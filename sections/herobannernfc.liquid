{%- style -%}
  #shopify-section-{{ section.id }} {
    --hero-bg: {{ section.settings.bg_color }};
    --hero-bg-pattern: {{ section.settings.bg_pattern_color }};
    --hero-badge-bg: {{ section.settings.badge_bg }};
    --hero-badge-text: {{ section.settings.badge_text_color }};
    --hero-heading-color: {{ section.settings.heading_color }};
    --hero-heading-accent: {{ section.settings.heading_accent_color }};
    --hero-text-color: {{ section.settings.subtext_color }};
    --hero-button-bg: {{ section.settings.button_bg }};
    --hero-button-text: {{ section.settings.button_text_color }};
    --hero-stat-number-color: {{ section.settings.stat_number_color }};
    --hero-stat-label-color: {{ section.settings.stat_label_color }};
    --hero-divider-color: {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .hero-banner {
    position: relative;
    width: 100%;
    background-color: var(--hero-bg);
    background-image: linear-gradient(var(--hero-bg-pattern) 1px, transparent 1px), linear-gradient(90deg, var(--hero-bg-pattern) 1px, transparent 1px);
    background-size: 32px 32px;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  #shopify-section-{{ section.id }} .hero-banner__container {
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 24px;
    display: grid;
    grid-template-columns: {% if section.settings.image_position == 'right' %}minmax(0, 1fr) minmax(0, 1fr){% else %}minmax(0, 1fr) minmax(0, 1fr){% endif %};
    gap: 48px;
    align-items: center;
  }

  {%- if section.settings.image_position == 'left' -%}
    #shopify-section-{{ section.id }} .hero-banner__content { order: 2; }
    #shopify-section-{{ section.id }} .hero-banner__media { order: 1; }
  {%- endif -%}

  #shopify-section-{{ section.id }} .hero-banner__badge {
    display: inline-block;
    background: var(--hero-badge-bg);
    color: var(--hero-badge-text);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 10px 20px;
    border-radius: 999px;
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }} .hero-banner__heading {
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 800;
    line-height: 1.1;
    color: var(--hero-heading-color);
    margin: 0 0 20px;
  }

  #shopify-section-{{ section.id }} .hero-banner__heading .accent {
    color: var(--hero-heading-accent);
    display: block;
  }

  #shopify-section-{{ section.id }} .hero-banner__subtext {
    color: var(--hero-text-color);
    font-size: 17px;
    line-height: 1.6;
    max-width: 480px;
    margin: 0 0 32px;
  }

  #shopify-section-{{ section.id }} .hero-banner__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--hero-button-bg);
    color: var(--hero-button-text);
    font-weight: 700;
    font-size: 16px;
    padding: 16px 28px;
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .hero-banner__button:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  #shopify-section-{{ section.id }} .hero-banner__button svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .hero-banner__stats {
    display: flex;
    gap: 32px;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--hero-divider-color);
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .hero-banner__stat-number {
    color: var(--hero-stat-number-color);
    font-size: 26px;
    font-weight: 800;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .hero-banner__stat-label {
    color: var(--hero-stat-label-color);
    font-size: 13px;
    margin-top: 2px;
  }

  #shopify-section-{{ section.id }} .hero-banner__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .hero-banner__media img {
    width: 100%;
    height: auto;
    max-width: 560px;
    display: block;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .hero-banner__media-placeholder {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px dashed rgba(255, 255, 255, 0.25);
    border-radius: 16px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 14px;
    text-align: center;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .hero-banner__media-placeholder svg {
    width: 42px;
    height: 42px;
    opacity: 0.5;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .hero-banner__container {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    #shopify-section-{{ section.id }} .hero-banner__content,
    #shopify-section-{{ section.id }} .hero-banner__media {
      order: initial;
    }

    #shopify-section-{{ section.id }} .hero-banner__media {
      order: -1;
    }

    #shopify-section-{{ section.id }} .hero-banner__content {
      order: 1;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .hero-banner__subtext {
      margin-inline: auto;
    }

    #shopify-section-{{ section.id }} .hero-banner__stats {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .hero-banner__button {
      justify-content: center;
    }
  }

  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .hero-banner {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .hero-banner__container {
      padding-inline: 20px;
    }

    #shopify-section-{{ section.id }} .hero-banner__button {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .hero-banner__stats {
      gap: 20px;
    }

    #shopify-section-{{ section.id }} .hero-banner__stat-number {
      font-size: 21px;
    }
  }
{%- endstyle -%}

<div class="hero-banner">
  <div class="hero-banner__container">

    <div class="hero-banner__content">
      {%- if section.settings.badge_text != blank -%}
        <span class="hero-banner__badge">{{ section.settings.badge_text }}</span>
      {%- endif -%}

      {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
        <h1 class="hero-banner__heading">
          {%- if section.settings.heading_line_1 != blank -%}{{ section.settings.heading_line_1 }}{%- endif -%}
          {%- if section.settings.heading_line_2 != blank -%}<span class="accent">{{ section.settings.heading_line_2 }}</span>{%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <div class="hero-banner__subtext">{{ section.settings.subtext }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="hero-banner__button">
          {{ section.settings.button_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hero-banner__stats">
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div class="hero-banner__stat" {{ block.shopify_attributes }}>
                <div class="hero-banner__stat-number">{{ block.settings.stat_number }}</div>
                <div class="hero-banner__stat-label">{{ block.settings.stat_label }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero-banner__media">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '400,600,800,1000,1200', alt: section.settings.heading_line_1 | default: 'Hero image' }}
      {%- else -%}
        <div class="hero-banner__media-placeholder">
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            <p>{{ 'Add an image in section settings' }}</p>
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero-banner-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "GET REVIEWS IN JUST 3 SECONDS!"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading (line 1)",
      "default": "Collect Reviews &"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading (line 2, accent color)",
      "default": "Rank #1 on Google"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Collect more Google reviews and grow your social media presence with our innovative NFC signs.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover Our Products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Layout / Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop, px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop, px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile, px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile, px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#191919"
    },
    {
      "type": "color",
      "id": "bg_pattern_color",
      "label": "Background grid pattern",
      "default": "#232323"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#f4b400"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#191919"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_accent_color",
      "label": "Heading accent (line 2)",
      "default": "#f4b400"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext",
      "default": "#c9c9c9"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#191919"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Stats divider line",
      "default": "#3a3a3a"
    },
    {
      "type": "color",
      "id": "stat_number_color",
      "label": "Stat number",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "stat_label_color",
      "label": "Stat label",
      "default": "#9c9c9c"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "stat_number",
          "label": "Number",
          "default": "2,228+"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Label",
          "default": "Reviews"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        { "type": "stat", "settings": { "stat_number": "2,228+", "stat_label": "Reviews" } },
        { "type": "stat", "settings": { "stat_number": "4.8/5", "stat_label": "Customer Reviews" } },
        { "type": "stat", "settings": { "stat_number": "48-72h", "stat_label": "Delivery" } }
      ]
    }
  ]
}
{% endschema %}