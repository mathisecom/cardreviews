{%- style -%}
  #shopify-section-{{ section.id }} {
    --trust-bg: {{ section.settings.bg_color }};
    --trust-heading-color: {{ section.settings.heading_color }};
    --trust-logo-height: {{ section.settings.logo_height }}px;
    --trust-logo-height-mobile: {{ section.settings.logo_height_mobile }}px;
    --trust-gap: {{ section.settings.logo_gap }}px;
    --trust-speed: {{ section.settings.scroll_speed }}s;
    --trust-heading-size: {{ section.settings.heading_font_size }}px;
    --trust-fade-width: {{ section.settings.fade_width }}px;
  }

  #shopify-section-{{ section.id }} .trust {
    width: 100%;
    background-color: var(--trust-bg);
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .trust__heading {
    text-align: center;
    color: var(--trust-heading-color);
    font-size: var(--trust-heading-size);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 32px;
  }

  #shopify-section-{{ section.id }} .trust__viewport {
    position: relative;
    width: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--trust-fade-width), #000 calc(100% - var(--trust-fade-width)), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 var(--trust-fade-width), #000 calc(100% - var(--trust-fade-width)), transparent 100%);
  }

  #shopify-section-{{ section.id }} .trust__track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: var(--trust-gap);
    animation: trust-scroll-{{ section.id }} var(--trust-speed) linear infinite;
  }

  {%- if section.settings.pause_on_hover -%}
    #shopify-section-{{ section.id }} .trust__viewport:hover .trust__track {
      animation-play-state: paused;
    }
  {%- endif -%}

  {%- if section.settings.reverse_direction -%}
    #shopify-section-{{ section.id }} .trust__track {
      animation-direction: reverse;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .trust__logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--trust-logo-height);
  }

  #shopify-section-{{ section.id }} .trust__logo img {
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: contain;
    display: block;
    {%- if section.settings.grayscale -%}
      filter: grayscale(100%) opacity(0.6);
      transition: filter 0.25s ease;
    {%- endif -%}
  }

  {%- if section.settings.grayscale -%}
    #shopify-section-{{ section.id }} .trust__logo:hover img {
      filter: grayscale(0%) opacity(1);
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .trust__logo-placeholder {
    height: var(--trust-logo-height);
    padding-inline: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(10, 31, 68, 0.35);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    border: 1px dashed rgba(10, 31, 68, 0.2);
    border-radius: 8px;
  }

  @keyframes trust-scroll-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .trust__track {
      animation: none;
    }
  }

  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .trust {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} {
      --trust-logo-height: {{ section.settings.logo_height_mobile }}px;
    }

    #shopify-section-{{ section.id }} .trust__heading {
      font-size: calc(var(--trust-heading-size) * 0.85);
      margin-bottom: 24px;
      padding-inline: 20px;
    }
  }
{%- endstyle -%}

<div class="trust">
  {%- if section.settings.heading != blank -%}
    <p class="trust__heading">{{ section.settings.heading }}</p>
  {%- endif -%}

  <div class="trust__viewport">
    <div class="trust__track">
      {%- liquid
        assign logo_blocks = section.blocks | where: 'type', 'logo'
      -%}
      {%- if logo_blocks.size > 0 -%}
        {%- for i in (1..2) -%}
          {%- for block in logo_blocks -%}
            <div class="trust__logo" {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %} aria-hidden="{% unless forloop.parentloop.first %}true{% endunless %}">
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
              {%- if block.settings.logo != blank -%}
                {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.alt | default: 'Logo' }}
              {%- else -%}
                <span class="trust__logo-placeholder">{{ block.settings.alt | default: 'Logo' }}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust Logo Marquee",
  "tag": "section",
  "class": "section-trust-marquee-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ILS COMMUNIQUENT DÉJÀ AVEC IZIKARD"
    },
    {
      "type": "header",
      "content": "Marquee behavior"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed (seconds per loop)",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "reverse_direction",
      "label": "Reverse direction",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Grayscale logos (color on hover)",
      "default": true
    },
    {
      "type": "range",
      "id": "fade_width",
      "label": "Edge fade width (px)",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80
    },
    {
      "type": "header",
      "content": "Layout / Spacing"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height — desktop (px)",
      "min": 16,
      "max": 96,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height — mobile (px)",
      "min": 12,
      "max": 72,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap between logos (px)",
      "min": 16,
      "max": 160,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop, px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop, px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile, px)",
      "min": 0,
      "max": 96,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile, px)",
      "min": 0,
      "max": 96,
      "step": 4,
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#8A94A6"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 13
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text / fallback label",
          "default": "Brand"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Logo Marquee",
      "blocks": [
        { "type": "logo", "settings": { "alt": "Krys" } },
        { "type": "logo", "settings": { "alt": "Decathlon" } },
        { "type": "logo", "settings": { "alt": "Au Bureau" } },
        { "type": "logo", "settings": { "alt": "Besson" } },
        { "type": "logo", "settings": { "alt": "Atol" } },
        { "type": "logo", "settings": { "alt": "McDonald's" } },
        { "type": "logo", "settings": { "alt": "Orpi" } },
        { "type": "logo", "settings": { "alt": "Burger King" } },
        { "type": "logo", "settings": { "alt": "Franck Provost" } },
        { "type": "logo", "settings": { "alt": "New School" } },
        { "type": "logo", "settings": { "alt": "E.Leclerc" } },
        { "type": "logo", "settings": { "alt": "Elec Depot" } }
      ]
    }
  ]
}
{% endschema %}