{%- style -%}
  #shopify-section-{{ section.id }} {
    --dbl-bg: {{ section.settings.bg_color }};
    --dbl-heading-color: {{ section.settings.heading_color }};
    --dbl-accent-color: {{ section.settings.accent_color }};
    --dbl-text-color: {{ section.settings.text_color }};
    --dbl-strong-color: {{ section.settings.text_strong_color }};
    --dbl-top-heading-size: {{ section.settings.top_heading_font_size_desktop }}px;
    --dbl-top-heading-size-mobile: {{ section.settings.top_heading_font_size_mobile }}px;
    --dbl-content-heading-size: {{ section.settings.content_heading_font_size_desktop }}px;
    --dbl-content-heading-size-mobile: {{ section.settings.content_heading_font_size_mobile }}px;
    --dbl-text-size: {{ section.settings.text_font_size }}px;
  }

  #shopify-section-{{ section.id }} .dbl {
    width: 100%;
    background-color: var(--dbl-bg);
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  #shopify-section-{{ section.id }} .dbl__container {
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 24px;
  }

  #shopify-section-{{ section.id }} .dbl__top-heading {
    text-align: center;
    color: var(--dbl-heading-color);
    font-size: var(--dbl-top-heading-size);
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 48px;
  }

  #shopify-section-{{ section.id }} .dbl__top-heading .accent {
    color: var(--dbl-accent-color);
  }

  #shopify-section-{{ section.id }} .dbl__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  {%- if section.settings.image_position == 'right' -%}
    #shopify-section-{{ section.id }} .dbl__media { order: 2; }
    #shopify-section-{{ section.id }} .dbl__content { order: 1; }
  {%- endif -%}

  #shopify-section-{{ section.id }} .dbl__media img {
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_radius }}px;
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .dbl__media-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 31, 68, 0.03);
    border: 1px dashed rgba(10, 31, 68, 0.2);
    border-radius: {{ section.settings.image_radius }}px;
    color: rgba(10, 31, 68, 0.4);
    font-size: 14px;
    text-align: center;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .dbl__media-placeholder svg {
    width: 42px;
    height: 42px;
    opacity: 0.5;
  }

  #shopify-section-{{ section.id }} .dbl__content-heading {
    color: var(--dbl-heading-color);
    font-size: var(--dbl-content-heading-size);
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 20px;
  }

  #shopify-section-{{ section.id }} .dbl__content-heading .accent {
    color: var(--dbl-accent-color);
  }

  #shopify-section-{{ section.id }} .dbl__text {
    color: var(--dbl-text-color);
    font-size: var(--dbl-text-size);
    line-height: 1.6;
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .dbl__text:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .dbl__text strong {
    color: var(--dbl-strong-color);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .dbl__text p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .dbl__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    #shopify-section-{{ section.id }} .dbl__media,
    #shopify-section-{{ section.id }} .dbl__content {
      order: initial;
    }

    #shopify-section-{{ section.id }} .dbl__content {
      text-align: center;
    }
  }

  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .dbl {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .dbl__container {
      padding-inline: 20px;
    }

    #shopify-section-{{ section.id }} .dbl__top-heading {
      font-size: var(--dbl-top-heading-size-mobile);
      margin-bottom: 32px;
    }

    #shopify-section-{{ section.id }} .dbl__content-heading {
      font-size: var(--dbl-content-heading-size-mobile);
    }
  }
{%- endstyle -%}

<div class="dbl" dir="{{ section.settings.text_direction }}">
  <div class="dbl__container">

    {%- if section.settings.top_heading_text != blank or section.settings.top_heading_accent != blank -%}
      <h2 class="dbl__top-heading">
        {%- if section.settings.top_heading_text != blank -%}{{ section.settings.top_heading_text }} {%- endif -%}
        {%- if section.settings.top_heading_accent != blank -%}<span class="accent">{{ section.settings.top_heading_accent }}</span>{%- endif -%}
      </h2>
    {%- endif -%}

    <div class="dbl__grid">
      <div class="dbl__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', alt: section.settings.content_heading_text | default: 'Image' }}
        {%- else -%}
          <div class="dbl__media-placeholder">
            <div>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              <p>{{ 'Add an image in section settings' }}</p>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="dbl__content">
        {%- if section.settings.content_heading_text != blank or section.settings.content_heading_accent != blank -%}
          <h3 class="dbl__content-heading">
            {%- if section.settings.content_heading_text != blank -%}{{ section.settings.content_heading_text }} {%- endif -%}
            {%- if section.settings.content_heading_accent != blank -%}<span class="accent">{{ section.settings.content_heading_accent }}</span>{%- endif -%}
          </h3>
        {%- endif -%}

        {%- if section.settings.paragraph_1 != blank -%}
          <div class="dbl__text">{{ section.settings.paragraph_1 }}</div>
        {%- endif -%}

        {%- if section.settings.paragraph_2 != blank -%}
          <div class="dbl__text">{{ section.settings.paragraph_2 }}</div>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Double Reviews Split",
  "tag": "section",
  "class": "section-double-reviews-split-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "text_direction",
      "label": "Text direction",
      "options": [
        { "value": "rtl", "label": "RTL (Hebrew / Arabic)" },
        { "value": "ltr", "label": "LTR" }
      ],
      "default": "rtl"
    },
    {
      "type": "text",
      "id": "top_heading_text",
      "label": "Top heading",
      "default": "קבלו ביקורות תוך"
    },
    {
      "type": "text",
      "id": "top_heading_accent",
      "label": "Top heading — accent part",
      "default": "3 שניות בלבד!"
    },
    {
      "type": "text",
      "id": "content_heading_text",
      "label": "Content heading",
      "default": "הכפילו את כמות הביקורות שלכם בגוגל תוך"
    },
    {
      "type": "text",
      "id": "content_heading_accent",
      "label": "Content heading — accent part",
      "default": "90 יום"
    },
    {
      "type": "richtext",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "<p>אלו הנתונים הממוצעים של הלקוחות שלנו.</p>"
    },
    {
      "type": "richtext",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "<p>אתם נמצאים במגע עם הלקוחות שלכם <strong>כל יום</strong>, אל תפספסו את ההזדמנות לאסוף <strong>את הביקורת שלהם בגוגל!</strong></p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius (px)",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout / Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop, px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop, px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile, px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile, px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#0A1F44"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#0066FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Paragraph text",
      "default": "#5C6577"
    },
    {
      "type": "color",
      "id": "text_strong_color",
      "label": "Bold text color",
      "default": "#0A1F44"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "top_heading_font_size_desktop",
      "label": "Top heading font size — desktop (px)",
      "min": 18,
      "max": 56,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "top_heading_font_size_mobile",
      "label": "Top heading font size — mobile (px)",
      "min": 16,
      "max": 40,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "content_heading_font_size_desktop",
      "label": "Content heading font size — desktop (px)",
      "min": 18,
      "max": 56,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "content_heading_font_size_mobile",
      "label": "Content heading font size — mobile (px)",
      "min": 16,
      "max": 40,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Paragraph font size (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 17
    }
  ],
  "presets": [
    {
      "name": "Double Reviews Split"
    }
  ]
}
{% endschema %}