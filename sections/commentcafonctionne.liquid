{% comment %}
  Section Shopify : Comment ça marche — Avisi
  - Tous les textes visibles par défaut sont en hébreu
  - Slider responsive ordinateur + mobile
  - Navigation par flèches, points et geste tactile
  - Aucun script externe
{% endcomment %}

<section
  id="avisi-how-{{ section.id }}"
  class="avisi-how"
  dir="rtl"
  style="
    --avisi-bg: {{ section.settings.background_color }};
    --avisi-card-bg: {{ section.settings.card_background }};
    --avisi-blue: {{ section.settings.accent_color }};
    --avisi-heading: {{ section.settings.heading_color }};
    --avisi-text: {{ section.settings.text_color }};
    --avisi-muted: {{ section.settings.muted_color }};
    --avisi-border: {{ section.settings.border_color }};
    --avisi-radius: {{ section.settings.card_radius }}px;
    --avisi-gap: {{ section.settings.card_gap }}px;
    --avisi-max-width: {{ section.settings.max_width }}px;
  "
>
  <div class="avisi-how__container">
    <header class="avisi-how__header">
      {% if section.settings.heading != blank %}
        <h2 class="avisi-how__title">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="avisi-how__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
    </header>

    {% if section.blocks.size > 0 %}
      <div class="avisi-how__slider" data-avisi-slider>
        <div
          class="avisi-how__track"
          data-avisi-track
          tabindex="0"
          role="region"
          aria-label="{{ section.settings.slider_accessibility_label | escape }}"
        >
          {% for block in section.blocks %}
            <article
              class="avisi-how__slide"
              data-avisi-slide
              {{ block.shopify_attributes }}
            >
              <div class="avisi-how__number" aria-hidden="true">
                {{ block.settings.number | default: forloop.index }}
              </div>

              {% if block.settings.title != blank %}
                <h3 class="avisi-how__step-title">{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="avisi-how__step-text">{{ block.settings.text | escape | newline_to_br }}</p>
              {% endif %}
            </article>
          {% endfor %}
        </div>

        {% if section.blocks.size > 1 and section.settings.show_controls %}
          <div class="avisi-how__controls">
            <button
              type="button"
              class="avisi-how__arrow"
              data-avisi-prev
              aria-label="{{ section.settings.previous_label | escape }}"
            >
              <span aria-hidden="true">→</span>
            </button>

            <div
              class="avisi-how__dots"
              data-avisi-dots
              aria-label="{{ section.settings.pagination_label | escape }}"
            >
              {% for block in section.blocks %}
                <button
                  type="button"
                  class="avisi-how__dot{% if forloop.first %} is-active{% endif %}"
                  data-avisi-dot="{{ forloop.index0 }}"
                  aria-label="הצגת שלב {{ forloop.index }}"
                  {% if forloop.first %}aria-current="true"{% endif %}
                ></button>
              {% endfor %}
            </div>

            <button
              type="button"
              class="avisi-how__arrow"
              data-avisi-next
              aria-label="{{ section.settings.next_label | escape }}"
            >
              <span aria-hidden="true">←</span>
            </button>
          </div>
        {% endif %}
      </div>
    {% elsif request.design_mode %}
      <div class="avisi-how__empty">
        הוסיפו שלבים בעורך התבנית.
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #avisi-how-{{ section.id }} {
    overflow: hidden;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--avisi-bg);
    color: var(--avisi-text);
  }

  #avisi-how-{{ section.id }} * {
    box-sizing: border-box;
  }

  #avisi-how-{{ section.id }} .avisi-how__container {
    width: min(calc(100% - 40px), var(--avisi-max-width));
    margin: 0 auto;
  }

  #avisi-how-{{ section.id }} .avisi-how__header {
    max-width: {{ section.settings.header_max_width }}px;
    margin: 0 auto {{ section.settings.header_bottom_spacing }}px;
    text-align: center;
  }

  #avisi-how-{{ section.id }} .avisi-how__title {
    margin: 0;
    color: var(--avisi-heading);
    font-size: clamp(
      {{ section.settings.heading_size_mobile }}px,
      3vw,
      {{ section.settings.heading_size_desktop }}px
    );
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  #avisi-how-{{ section.id }} .avisi-how__subtitle {
    margin: 12px 0 0;
    color: var(--avisi-muted);
    font-size: {{ section.settings.subtitle_size }}px;
    line-height: 1.55;
  }

  #avisi-how-{{ section.id }} .avisi-how__slider {
    position: relative;
  }

  #avisi-how-{{ section.id }} .avisi-how__track {
    direction: ltr;
    display: flex;
    gap: var(--avisi-gap);
    overflow-x: auto;
    padding: 8px 2px 14px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  #avisi-how-{{ section.id }} .avisi-how__track::-webkit-scrollbar {
    display: none;
  }

  #avisi-how-{{ section.id }} .avisi-how__slide {
    direction: rtl;
    flex: 0 0 calc(
      (100% - ({{ section.settings.desktop_slides_visible | minus: 1 }} * var(--avisi-gap)))
      / {{ section.settings.desktop_slides_visible }}
    );
    min-width: 0;
    min-height: {{ section.settings.card_min_height }}px;
    padding: {{ section.settings.card_padding }}px;
    background: var(--avisi-card-bg);
    border: {{ section.settings.border_width }}px solid var(--avisi-border);
    border-radius: var(--avisi-radius);
    box-shadow:
      0 {{ section.settings.shadow_y }}px {{ section.settings.shadow_blur }}px
      rgba(17, 24, 39, {{ section.settings.shadow_opacity | divided_by: 100.0 }});
    text-align: center;
    scroll-snap-align: start;
  }

  #avisi-how-{{ section.id }} .avisi-how__number {
    display: grid;
    width: {{ section.settings.number_size }}px;
    height: {{ section.settings.number_size }}px;
    margin: 0 auto {{ section.settings.number_bottom_spacing }}px;
    place-items: center;
    background: var(--avisi-blue);
    border-radius: {{ section.settings.number_radius }}px;
    box-shadow:
      0 8px 20px
      rgba(0, 102, 255, {{ section.settings.number_shadow_opacity | divided_by: 100.0 }});
    color: #ffffff;
    font-size: {{ section.settings.number_font_size }}px;
    font-weight: 800;
    line-height: 1;
  }

  #avisi-how-{{ section.id }} .avisi-how__step-title {
    margin: 0;
    color: var(--avisi-heading);
    font-size: {{ section.settings.step_title_size }}px;
    font-weight: {{ section.settings.step_title_weight }};
    line-height: 1.3;
  }

  #avisi-how-{{ section.id }} .avisi-how__step-text {
    max-width: {{ section.settings.text_max_width }}px;
    margin: 12px auto 0;
    color: var(--avisi-muted);
    font-size: {{ section.settings.step_text_size }}px;
    line-height: {{ section.settings.step_text_line_height | divided_by: 100.0 }};
  }

  #avisi-how-{{ section.id }} .avisi-how__controls {
    direction: ltr;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: {{ section.settings.controls_top_spacing }}px;
  }

  #avisi-how-{{ section.id }} .avisi-how__arrow {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    padding: 0;
    background: var(--avisi-blue);
    border: 1px solid var(--avisi-blue);
    border-radius: 999px;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    font-size: 21px;
    transition: opacity 160ms ease, transform 160ms ease;
  }

  #avisi-how-{{ section.id }} .avisi-how__arrow:hover {
    transform: translateY(-1px);
  }

  #avisi-how-{{ section.id }} .avisi-how__arrow:active {
    transform: scale(0.96);
  }

  #avisi-how-{{ section.id }} .avisi-how__arrow:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  #avisi-how-{{ section.id }} .avisi-how__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  #avisi-how-{{ section.id }} .avisi-how__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    background: var(--avisi-border);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: width 160ms ease, background-color 160ms ease;
  }

  #avisi-how-{{ section.id }} .avisi-how__dot.is-active {
    width: 24px;
    background: var(--avisi-blue);
  }

  #avisi-how-{{ section.id }} .avisi-how__empty {
    padding: 32px;
    border: 1px dashed var(--avisi-border);
    border-radius: var(--avisi-radius);
    color: var(--avisi-muted);
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    #avisi-how-{{ section.id }} .avisi-how__slide {
      flex-basis: calc(
        (100% - ({{ section.settings.tablet_slides_visible | minus: 1 }} * var(--avisi-gap)))
        / {{ section.settings.tablet_slides_visible }}
      );
    }
  }

  @media screen and (max-width: 749px) {
    #avisi-how-{{ section.id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    #avisi-how-{{ section.id }} .avisi-how__container {
      width: min(calc(100% - 28px), var(--avisi-max-width));
    }

    #avisi-how-{{ section.id }} .avisi-how__header {
      margin-bottom: {{ section.settings.header_bottom_spacing_mobile }}px;
    }

    #avisi-how-{{ section.id }} .avisi-how__subtitle {
      font-size: {{ section.settings.subtitle_size_mobile }}px;
    }

    #avisi-how-{{ section.id }} .avisi-how__slider {
      margin-left: -14px;
    }

    #avisi-how-{{ section.id }} .avisi-how__track {
      gap: {{ section.settings.mobile_gap }}px;
      padding-left: 14px;
    }

    #avisi-how-{{ section.id }} .avisi-how__slide {
      flex: 0 0 {{ section.settings.mobile_slide_width }}%;
      min-height: {{ section.settings.card_min_height_mobile }}px;
      padding: {{ section.settings.card_padding_mobile }}px;
    }

    #avisi-how-{{ section.id }} .avisi-how__step-title {
      font-size: {{ section.settings.step_title_size_mobile }}px;
    }

    #avisi-how-{{ section.id }} .avisi-how__step-text {
      font-size: {{ section.settings.step_text_size_mobile }}px;
    }

    #avisi-how-{{ section.id }} .avisi-how__controls {
      margin-top: {{ section.settings.controls_top_spacing_mobile }}px;
      padding-left: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #avisi-how-{{ section.id }} .avisi-how__track {
      scroll-behavior: auto;
    }

    #avisi-how-{{ section.id }} .avisi-how__arrow,
    #avisi-how-{{ section.id }} .avisi-how__dot {
      transition: none;
    }
  }
{% endstyle %}

<script>
  (() => {
    const section = document.getElementById('avisi-how-{{ section.id }}');
    if (!section || section.dataset.avisiReady === 'true') return;

    section.dataset.avisiReady = 'true';

    const track = section.querySelector('[data-avisi-track]');
    const slides = Array.from(section.querySelectorAll('[data-avisi-slide]'));
    const previousButton = section.querySelector('[data-avisi-prev]');
    const nextButton = section.querySelector('[data-avisi-next]');
    const dots = Array.from(section.querySelectorAll('[data-avisi-dot]'));

    if (!track || slides.length < 2) return;

    let activeIndex = 0;
    let animationFrame;
    let autoplayTimer;

    const autoplayEnabled = {{ section.settings.autoplay | json }};
    const autoplayDelay = {{ section.settings.autoplay_delay | times: 1000 }};

    const getVisibleCount = () => {
      if (window.matchMedia('(max-width: 749px)').matches) return 1;
      if (window.matchMedia('(max-width: 989px)').matches) {
        return Math.max(1, {{ section.settings.tablet_slides_visible }});
      }
      return Math.max(1, {{ section.settings.desktop_slides_visible }});
    };

    const getMaximumIndex = () => Math.max(0, slides.length - getVisibleCount());

    const getOffset = (index) => {
      const slide = slides[index];
      return slide ? slide.offsetLeft - track.offsetLeft : 0;
    };

    const updateState = (index) => {
      activeIndex = Math.max(0, Math.min(index, getMaximumIndex()));

      dots.forEach((dot, dotIndex) => {
        const selected = dotIndex === activeIndex;
        dot.classList.toggle('is-active', selected);

        if (selected) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });

      if (previousButton) previousButton.disabled = activeIndex === 0;
      if (nextButton) nextButton.disabled = activeIndex >= getMaximumIndex();
    };

    const goTo = (index) => {
      const targetIndex = Math.max(0, Math.min(index, getMaximumIndex()));

      track.scrollTo({
        left: getOffset(targetIndex),
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
      });

      updateState(targetIndex);
    };

    const syncFromScroll = () => {
      window.cancelAnimationFrame(animationFrame);

      animationFrame = window.requestAnimationFrame(() => {
        const currentScroll = track.scrollLeft;
        let closestIndex = 0;
        let closestDistance = Infinity;

        slides.forEach((slide, index) => {
          const distance = Math.abs(getOffset(index) - currentScroll);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        updateState(closestIndex);
      });
    };

    const stopAutoplay = () => {
      if (autoplayTimer) {
        window.clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    };

    const startAutoplay = () => {
      if (!autoplayEnabled || slides.length < 2) return;

      stopAutoplay();

      autoplayTimer = window.setInterval(() => {
        const maximumIndex = getMaximumIndex();
        const nextIndex = activeIndex >= maximumIndex ? 0 : activeIndex + 1;
        goTo(nextIndex);
      }, autoplayDelay);
    };

    previousButton?.addEventListener('click', () => {
      goTo(activeIndex - 1);
      startAutoplay();
    });

    nextButton?.addEventListener('click', () => {
      goTo(activeIndex + 1);
      startAutoplay();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number(dot.dataset.avisiDot));
        startAutoplay();
      });
    });

    track.addEventListener('scroll', syncFromScroll, { passive: true });
    track.addEventListener('mouseenter', stopAutoplay);
    track.addEventListener('mouseleave', startAutoplay);
    track.addEventListener('focusin', stopAutoplay);
    track.addEventListener('focusout', startAutoplay);
    track.addEventListener('touchstart', stopAutoplay, { passive: true });
    track.addEventListener('touchend', startAutoplay, { passive: true });

    window.addEventListener('resize', () => {
      goTo(Math.min(activeIndex, getMaximumIndex()));
    });

    updateState(0);
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "Comment ça marche Avisi",
  "tag": "section",
  "class": "section-avisi-how",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Contenu visible"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "איך זה עובד?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "3 שלבים פשוטים לאיסוף יותר ביקורות"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond de la section",
      "default": "#F9FAFB"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fond des étapes",
      "default": "#F9FAFB"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur principale",
      "default": "#0066FF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Titres",
      "default": "#10131A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "#303641"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Texte secondaire",
      "default": "#697181"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bordures et pagination",
      "default": "#E5EAF2"
    },
    {
      "type": "header",
      "content": "Disposition"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Largeur maximale de l’en-tête",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 700
    },
    {
      "type": "range",
      "id": "desktop_slides_visible",
      "label": "Étapes visibles sur ordinateur",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "tablet_slides_visible",
      "label": "Étapes visibles sur tablette",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_slide_width",
      "label": "Largeur d’une étape sur mobile",
      "min": 82,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Espace entre les étapes",
      "min": 8,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Espace mobile",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_min_height",
      "label": "Hauteur minimale ordinateur",
      "min": 180,
      "max": 440,
      "step": 10,
      "unit": "px",
      "default": 230
    },
    {
      "type": "range",
      "id": "card_min_height_mobile",
      "label": "Hauteur minimale mobile",
      "min": 200,
      "max": 440,
      "step": 10,
      "unit": "px",
      "default": 250
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Marge intérieure ordinateur",
      "min": 12,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_padding_mobile",
      "label": "Marge intérieure mobile",
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Arrondi des étapes",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Épaisseur de bordure",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Numéros"
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Taille du carré",
      "min": 42,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    {
      "type": "range",
      "id": "number_radius",
      "label": "Arrondi du carré",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "number_font_size",
      "label": "Taille du chiffre",
      "min": 16,
      "max": 34,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "number_bottom_spacing",
      "label": "Espace sous le numéro",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "number_shadow_opacity",
      "label": "Opacité de l’ombre bleue",
      "min": 0,
      "max": 35,
      "step": 1,
      "unit": "%",
      "default": 24
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Titre sur ordinateur",
      "min": 26,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Titre sur mobile",
      "min": 24,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Graisse du titre",
      "default": "700",
      "options": [
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-gras" },
        { "value": "700", "label": "Gras" },
        { "value": "800", "label": "Très gras" }
      ]
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Sous-titre ordinateur",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "label": "Sous-titre mobile",
      "min": 13,
      "max": 21,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "step_title_size",
      "label": "Titre des étapes sur ordinateur",
      "min": 15,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
