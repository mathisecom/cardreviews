{%- style -%}
  #shopify-section-{{ section.id }} {
    --ir-bg: {{ section.settings.bg_color }};
    --ir-icon-color: {{ section.settings.icon_color }};
    --ir-text-color: {{ section.settings.text_color }};
    --ir-strong-color: {{ section.settings.text_strong_color }};
    --ir-star-color: {{ section.settings.star_color }};
    --ir-google-color: {{ section.settings.google_g_color }};
    --ir-columns-desktop: {{ section.settings.columns_desktop }};
    --ir-columns-mobile: {{ section.settings.columns_mobile }};
    --ir-gap: {{ section.settings.item_gap }}px;
    --ir-icon-size: {{ section.settings.icon_size }}px;
    --ir-text-size: {{ section.settings.text_font_size }}px;
  }

  #shopify-section-{{ section.id }} .icon-row {
    width: 100%;
    background-color: var(--ir-bg);
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  #shopify-section-{{ section.id }} .icon-row__container {
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 24px;
  }

  #shopify-section-{{ section.id }} .icon-row__heading {
    text-align: center;
    color: var(--ir-strong-color);
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 800;
    margin: 0 0 40px;
  }

  #shopify-section-{{ section.id }} .icon-row__grid {
    display: grid;
    grid-template-columns: repeat(var(--ir-columns-desktop), 1fr);
    gap: var(--ir-gap);
  }

  #shopify-section-{{ section.id }} .icon-row__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .icon-row__icon {
    width: var(--ir-icon-size);
    height: var(--ir-icon-size);
    margin-bottom: 16px;
    color: var(--ir-icon-color);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .icon-row__icon svg {
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .icon-row__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .icon-row__text {
    color: var(--ir-text-color);
    font-size: var(--ir-text-size);
    line-height: 1.45;
    max-width: 220px;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .icon-row__text strong {
    color: var(--ir-strong-color);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .icon-row__text p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .icon-row__grid {
      grid-template-columns: repeat(var(--ir-columns-mobile), 1fr);
      row-gap: calc(var(--ir-gap) * 1.4);
    }
  }

  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .icon-row {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .icon-row__container {
      padding-inline: 20px;
    }

    #shopify-section-{{ section.id }} .icon-row__heading {
      font-size: calc({{ section.settings.heading_font_size }}px * 0.8);
      margin-bottom: 28px;
    }

    #shopify-section-{{ section.id }} .icon-row__icon {
      width: calc(var(--ir-icon-size) * 0.8);
      height: calc(var(--ir-icon-size) * 0.8);
    }
  }
{%- endstyle -%}

<div class="icon-row" dir="{{ section.settings.text_direction }}">
  <div class="icon-row__container">

    {%- if section.settings.heading != blank -%}
      <h2 class="icon-row__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="icon-row__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          <div class="icon-row__item" {{ block.shopify_attributes }}>
            <span class="icon-row__icon">
              {%- if block.settings.custom_icon != blank -%}
                <img src="{{ block.settings.custom_icon | image_url: width: 200 }}" alt="{{ block.settings.icon_alt | default: '' | escape }}" loading="lazy">
              {%- else -%}
                {%- case block.settings.icon_type -%}
                  {%- when 'google_badge' -%}
                    <svg viewBox="0 0 64 64" fill="none">
                      <g fill="var(--ir-star-color)">
                        <path d="M32 2l1.9 4.6 5 .4-3.8 3.2 1.2 4.9L32 12.6l-4.3 2.5 1.2-4.9-3.8-3.2 5-.4z"/>
                        <path d="M14 12l1.3 3.1 3.4.3-2.6 2.2.8 3.3L14 19l-2.9 1.9.8-3.3-2.6-2.2 3.4-.3z"/>
                        <path d="M50 12l1.3 3.1 3.4.3-2.6 2.2.8 3.3L50 19l-2.9 1.9.8-3.3-2.6-2.2 3.4-.3z"/>
                      </g>
                      <circle cx="32" cy="38" r="22" fill="none" stroke="var(--ir-google-color)" stroke-width="3"/>
                      <path d="M32 30v8h11.3c-.5 3-3.3 8.8-11.3 8.8-6.8 0-12.4-5.6-12.4-12.6S25.2 21.6 32 21.6c3.9 0 6.5 1.7 8 3.1l5.5-5.3C42.2 16.3 37.6 14 32 14c-13.3 0-24 10.7-24 24s10.7 24 24 24c13.9 0 23-9.8 23-23.5 0-1.6-.2-2.8-.4-4H32z" fill="var(--ir-google-color)"/>
                    </svg>
                  {%- when 'bolt' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10.5"/>
                      <polygon points="13 6 8 13 12 13 11 18 16 11 12 11 13 6"/>
                    </svg>
                  {%- when 'sparkles' -%}
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M11 2c.4 3.3 1.2 5.6 2.5 6.9C14.8 10.2 17.1 11 20.4 11.4c-3.3.4-5.6 1.2-6.9 2.5-1.3 1.3-2.1 3.6-2.5 6.9-.4-3.3-1.2-5.6-2.5-6.9C7.2 12.6 4.9 11.8 1.6 11.4c3.3-.4 5.6-1.2 6.9-2.5C9.8 7.6 10.6 5.3 11 2z"/>
                      <path d="M19 15.5c.2 1.5.6 2.5 1.2 3.1.6.6 1.6 1 3.1 1.2-1.5.2-2.5.6-3.1 1.2-.6.6-1 1.6-1.2 3.1-.2-1.5-.6-2.5-1.2-3.1-.6-.6-1.6-1-3.1-1.2 1.5-.2 2.5-.6 3.1-1.2.6-.6 1-1.6 1.2-3.1z"/>
                    </svg>
                  {%- when 'handshake' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M8.5 6.5c1.8-1.8 4.7-1.8 6.4 0"/>
                      <path d="M3.5 9.5l3-3c.8-.8 2-.8 2.8 0l1.7 1.7"/>
                      <path d="M20.5 9.5l-3-3c-.8-.8-2-.8-2.8 0l-1 1"/>
                      <path d="M6.5 12.5l2.6 2.6c.8.8 2 .8 2.8 0l.1-.1c.7-.7.7-1.9 0-2.6l-1.5-1.5"/>
                      <path d="M17.5 12.5l-2.6 2.6c-.8.8-2 .8-2.8 0"/>
                      <path d="M3.5 9.5v6M20.5 9.5v6"/>
                      <path d="M18 17.5c1.5-1.6 3.4-3.6 2.5-4.5"/>
                      <path d="M19.5 4.5c-2.4-2.4-6.3-2.4-8.7 0l-.3.3"/>
                    </svg>
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10.5"/><polyline points="7.5 12.5 10.5 15.5 16.5 9"/></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
            {%- if block.settings.text != blank -%}
              <div class="icon-row__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Icon Feature Row",
  "tag": "section",
  "class": "section-icon-feature-row-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "text_direction",
      "label": "Text direction",
      "options": [
        { "value": "rtl", "label": "RTL (Hebrew / Arabic)" },
        { "value": "ltr", "label": "LTR" }
      ],
      "default": "rtl"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size (px)",
      "min": 16,
      "max": 48,
      "step": 1,
      "default": 28
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns — desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "item_gap",
      "label": "Gap between items (px)",
      "min": 8,
      "max": 80,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size — desktop (px)",
      "min": 24,
      "max": 96,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text font size (px)",
      "min": 11,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "Layout / Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop, px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop, px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile, px)",
      "min": 0,
      "max": 96,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile, px)",
      "min": 0,
      "max": 96,
      "step": 4,
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color (default icons)",
      "default": "#0A1F44"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Google badge — stars color",
      "default": "#FBBC05"
    },
    {
      "type": "color",
      "id": "google_g_color",
      "label": "Google badge — G color",
      "default": "#0A1F44"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5C6577"
    },
    {
      "type": "color",
      "id": "text_strong_color",
      "label": "Bold text / heading color",
      "default": "#0A1F44"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "google_badge", "label": "Google badge" },
            { "value": "bolt", "label": "Lightning bolt" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "handshake", "label": "Handshake" },
            { "value": "check", "label": "Check" }
          ],
          "default": "google_badge"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon (overrides icon above)"
        },
        {
          "type": "text",
          "id": "icon_alt",
          "label": "Custom icon alt text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p><strong>כותרת מודגשת</strong> ואז טקסט רגיל.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Feature Row",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon_type": "google_badge",
            "text": "<p><strong>היו במקום הראשון בגוגל!</strong> ושמרו על היתרון</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_type": "bolt",
            "text": "<p><strong>הפניה מיידית</strong> לביקורות שלכם בגוגל</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_type": "sparkles",
            "text": "<p><strong>הלקוחות אוהבים את זה!</strong> פשוט וכיפי</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon_type": "handshake",
            "text": "<p>תנו ל<strong>לקוחות האמיתיים</strong> שלכם לדבר בשמכם!</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}