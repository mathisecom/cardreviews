      "label": "Marge haute — PC",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse — PC",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Marge haute — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Marge basse — mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_bottom_spacing",
      "label": "Espace sous le titre — PC",
      "min": 8,
      "max": 70,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "title_bottom_spacing_mobile",
      "label": "Espace sous le titre — mobile",
      "min": 8,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "dots_top_spacing",
      "label": "Espace au-dessus des points",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "placement",
      "name": "Emplacement",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Légende en hébreu",
          "default": "על הדלפק"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avisi — Emplacements",
      "blocks": [
        {
          "type": "placement",
          "settings": {
            "caption": "על הדלפק"
          }
        },
        {
          "type": "placement",
          "settings": {
            "caption": "על שולחן הקבלה"
          }
        },
        {
          "type": "placement",
          "settings": {
            "caption": "על הקיר"
          }
        },
        {
          "type": "placement",
          "settings": {
            "caption": "על השולחן"
          }
        }
      ]
    }
  ]
}
{% endschema %}