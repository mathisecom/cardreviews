{%- style -%}
  #shopify-section-{{ section.id }} {
    --wcu-bg: {{ section.settings.bg_color }};
    --wcu-heading-color: {{ section.settings.heading_color }};
    --wcu-title-color: {{ section.settings.item_title_color }};
    --wcu-text-color: {{ section.settings.item_text_color }};
    --wcu-heading-size: {{ section.settings.heading_font_size_desktop }}px;
    --wcu-heading-size-mobile: {{ section.settings.heading_font_size_mobile }}px;
    --wcu-title-size: {{ section.settings.item_title_font_size }}px;
    --wcu-text-size: {{ section.settings.item_text_font_size }}px;
  }

  #shopify-section-{{ section.id }} .wcu {
    width: 100%;
    background-color: var(--wcu-bg);
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  #shopify-section-{{ section.id }} .wcu__container {
    max-width: 1280px;
    margin: 0 auto;
    padding-inline: 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  {%- if section.settings.image_position == 'left' -%}
    #shopify-section-{{ section.id }} .wcu__content { order: 2; }
    #shopify-section-{{ section.id }} .wcu__media { order: 1; }
  {%- endif -%}

  #shopify-section-{{ section.id }} .wcu__heading {
    font-size: var(--wcu-heading-size);
    font-weight: 800;
    line-height: 1.2;
    color: var(--wcu-heading-color);
    margin: 0 0 28px;
  }

  #shopify-section-{{ section.id }} .wcu__list {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  #shopify-section-{{ section.id }} .wcu__item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .wcu__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .wcu__icon svg {
    width: 20px;
    height: 20px;
  }

  #shopify-section-{{ section.id }} .wcu__item-title {
    color: var(--wcu-title-color);
    font-size: var(--wcu-title-size);
    font-weight: 700;
    margin: 0 0 4px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .wcu__item-text {
    color: var(--wcu-text-color);
    font-size: var(--wcu-text-size);
    line-height: 1.55;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .wcu__media {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .wcu__media img {
    width: 100%;
    height: auto;
    max-width: 460px;
    display: block;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .wcu__media-placeholder {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 31, 68, 0.03);
    border: 1px dashed rgba(10, 31, 68, 0.2);
    border-radius: 16px;
    color: rgba(10, 31, 68, 0.4);
    font-size: 14px;
    text-align: center;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .wcu__media-placeholder svg {
    width: 42px;
    height: 42px;
    opacity: 0.5;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .wcu__container {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    #shopify-section-{{ section.id }} .wcu__content,
    #shopify-section-{{ section.id }} .wcu__media {
      order: initial;
    }
  }

  @media screen and (max-width: 599px) {
    #shopify-section-{{ section.id }} .wcu {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .wcu__container {
      padding-inline: 20px;
    }

    #shopify-section-{{ section.id }} .wcu__heading {
      font-size: var(--wcu-heading-size-mobile);
    }
  }
{%- endstyle -%}

<div class="wcu" dir="{{ section.settings.text_direction }}">
  <div class="wcu__container">

    <div class="wcu__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="wcu__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="wcu__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div class="wcu__item" {{ block.shopify_attributes }}>
              <span class="wcu__icon" style="background-color: {{ block.settings.icon_bg }}; color: {{ block.settings.icon_color }};">
                {%- if block.settings.icon_type == 'text' -%}
                  {{ block.settings.icon_text }}
                {%- else -%}
                  {%- case block.settings.icon_type -%}
                    {%- when 'check' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {%- when 'bolt' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {%- when 'star' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {%- when 'truck' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- endcase -%}
                {%- endif -%}
              </span>
              <div class="wcu__item-copy">
                {%- if block.settings.title != blank -%}
                  <h3 class="wcu__item-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="wcu__item-text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="wcu__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', alt: section.settings.heading | default: 'Product image' }}
      {%- else -%}
        <div class="wcu__media-placeholder">
          <div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            <p>{{ 'Add an image in section settings' }}</p>
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Why Choose Us",
  "tag": "section",
  "class": "section-why-choose-us-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "text_direction",
      "label": "Text direction",
      "options": [
        { "value": "rtl", "label": "RTL (Hebrew / Arabic)" },
        { "value": "ltr", "label": "LTR" }
      ],
      "default": "rtl"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "?למה לבחור ב-Avisi"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Layout / Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop, px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop, px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile, px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile, px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#0A1F44"
    },
    {
      "type": "color",
      "id": "item_title_color",
      "label": "Item title",
      "default": "#0A1F44"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Item text",
      "default": "#5C6577"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_font_size_desktop",
      "label": "Heading font size — desktop (px)",
      "min": 20,
      "max": 64,
      "step": 1,
      "default": 34
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading font size — mobile (px)",
      "min": 18,
      "max": 48,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "item_title_font_size",
      "label": "Item title font size (px)",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 17
    },
    {
      "type": "range",
      "id": "item_text_font_size",
      "label": "Item text font size (px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "clock", "label": "Clock" },
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Truck" },
            { "value": "text", "label": "Custom text (e.g. IL)" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Custom icon text",
          "default": "IL"
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "Icon background",
          "default": "#DCFCE7"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#16A34A"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "כותרת היתרון"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "תיאור קצר של היתרון."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon_type": "check",
            "icon_bg": "#DCFCE7",
            "icon_color": "#16A34A",
            "title": "יותר ביקורות בגוגל",
            "text": "הכפילו פי 5 את מספר הביקורות בעמוד העסק שלכם בגוגל בעזרת שלטי ה-NFC שלנו."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_type": "bolt",
            "icon_bg": "#DBEAFE",
            "icon_color": "#0066FF",
            "title": "התקנה מיידית",
            "text": "הדביקו את השלט וזהו! לא נדרשת שום הגדרה טכנית."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_type": "clock",
            "icon_bg": "#EDE9FE",
            "icon_color": "#7C3AED",
            "title": "שימוש לכל החיים",
            "text": "ללא מנוי, ללא עלויות נסתרות. לאחר הרכישה, השלט שלכם לתמיד."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_type": "text",
            "icon_text": "IL",
            "icon_bg": "#FEF9C3",
            "icon_color": "#854D0E",
            "title": "מיוצר בישראל",
            "text": "איכות פרימיום, ייצור מקומי ומשלוח מהיר מובטח."
          }
        }
      ]
    }
  ]
}
{% endschema %}